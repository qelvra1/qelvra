rivacy Policy",updated:"Last updated · May 2026",intro:"ARCHETYPE Private Estates respects the privacy of every client and visitor. This policy explains what we collect, why we collect it, and the discretion with which it is handled.",sections:[{heading:"Information We Collect",body:"We collect only what is necessary to serve you: contact details you provide when enquiring or subscribing, saved estate shortlists stored locally on your device, and anonymous usage metrics that help us improve the experience."},{heading:"How We Use It",body:"Your details are used exclusively to respond to enquiries, arrange private viewings, and deliver the properties and insights you request. We never sell or rent personal information to third parties."},{heading:"Cookies & Local Storage",body:"This site stores your favorite estates in your browser's local storage so your shortlist persists between visits. No cross-site tracking cookies are set by ARCHETYPE."},{heading:"Sharing & Discretion",body:"Information is shared only with advisors directly involved in serving your enquiry, or where required by law. Off-market and confidential listings are handled under strict non-disclosure."},{heading:"Your Rights",body:"You may request access to, correction of, or deletion of your personal information at any time by writing to privacy@archetype-estates.example. We respond within thirty days."}]},terms:{title:"Terms of Use",updated:"Last updated · May 2026",intro:"By accessing this site you agree to the following terms. They exist to protect both our clients and the integrity of the collection we present.",sections:[{heading:"Use of the Site",body:"The site is provided for private, non-commercial reference. You agree not to scrape, reproduce, or redistribute listings, imagery, or editorial content without written permission."},{heading:"Listings & Accuracy",body:"Prices, availability, and property details are indicative and subject to change without notice. A listing does not constitute an offer; all acquisitions are subject to contract and verification."},{heading:"Intellectual Property",body:"All photography, writing, marks, and design are the property of ARCHETYPE Private Estates or its licensors and remain protected under applicable copyright and trademark law."},{heading:"Limitation of Liability",body:"ARCHETYPE acts as an advisory and introduction service. To the fullest extent permitted by law, we are not liable for decisions made in reliance on site content independent of a formal advisory engagement."},{heading:"Governing Law",body:"These terms are governed by the laws of the jurisdiction in which your advisory agreement is executed. Any disputes will be resolved in the courts of that jurisdiction."}]}};function Cb({kind:f,onClose:n}){if(Ec(!!f),zc(!!f,n),!f)return null;const r=Nb[f];return S.jsxs("div",{role:"dialog","aria-modal":"true","aria-label":r.title,className:"animate-overlay fixed inset-0 z-[80] overflow-y-auto bg-paper",children:[S.jsx("div",{className:"sticky top-0 z-10 border-b border-line bg-paper/95 backdrop-blur-sm",children:S.jsxs("div",{className:"shell-x flex items-center justify-between py-4",children:[S.jsxs("button",{type:"button","data-dir":"back",onClick:n,className:"flex items-center gap-2 text-[11px] font-normal uppercase tracking-[0.2em] text-muted transition-colors hover:text-champagne",children:[S.jsx(ad,{size:14,strokeWidth:1.5}),"Back to Site"]}),S.jsxs("div",{className:"flex items-center gap-4",children:[S.jsx("p",{className:"eyebrow text-[10px] text-champagne hidden sm:block",children:"ARCHETYPE · Legal"}),S.jsx("button",{type:"button",onClick:n,"aria-label":`Close ${r.title}`,className:"btn-icon size-9",children:S.jsx($r,{size:16,strokeWidth:1.5})})]})]})}),S.jsxs("article",{className:"animate-rise mx-auto w-full max-w-[720px] px-6 pb-24 pt-14 sm:px-8",children:[S.jsx("p",{className:"eyebrow text-[10px] text-muted",children:r.updated}),S.jsx("h1",{className:"mt-3 font-display text-[34px] font-medium leading-[1.0